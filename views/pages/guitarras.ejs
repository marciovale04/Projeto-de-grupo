<%- include('../partials/header', { titulo: 'Guitarras' }) %>

  <main class="container mt-5">
    <h1 class="mb-4">Guitarras Disponíveis</h1>

    <div class="row">
      <% guitarras.forEach(guitarra=> {
        const pasta = guitarra.nome
        .toLowerCase()
        .replace(/\s+/g, "");
        %>

        <div class="col-md-4 mb-4">
          <div class="card h-100 shadow-sm">

            <!-- CAROUSEL (MANUAL) -->
            <div id="carousel<%= guitarra.id_guitarra %>" class="carousel slide" data-bs-ride="false"
              data-bs-interval="false">

              <div class="carousel-inner">
                <% for (let i=1; i <=4; i++) { %>
                  <div class="carousel-item <%= i === 1 ? 'active' : '' %>">
                    <img src="/images/guitarras/<%= pasta %>/<%= i %>.jpg" class="card-img-top"
                      alt="<%= guitarra.nome %>">
                  </div>
                  <% } %>
              </div>

              <!-- SETAS -->
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel<%= guitarra.id_guitarra %>"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
              </button>

              <button class="carousel-control-next" type="button" data-bs-target="#carousel<%= guitarra.id_guitarra %>"
                data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
              </button>

            </div>
            <!-- FIM CAROUSEL -->

            <div class="card-body">
              <h5 class="card-title">
                <%= guitarra.nome %>
              </h5>

              <p class="card-text">
                <strong>Marca:</strong>
                <%= guitarra.marca %><br>
                  <strong>Modelo:</strong>
                  <%= guitarra.modelo %>
              </p>

              <p class="fw-bold text-success">
                € <%= guitarra.preco_base %>
              </p>
              <a href="/guitarras/<%= guitarra.id_guitarra %>/personalizar" class="btn btn-outline-primary btn-sm mt-2">
                Personalizar
              </a>
            </div>

          </div>
        </div>

        <% }) %>
    </div>
  </main>

  <%- include('../partials/footer') %>